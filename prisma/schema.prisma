generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model blogusers {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  v           Int?     @map("__v")
  dateCreated DateTime @db.Date
  email       String
  password    String
  username    String   @unique
}

model posts {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  v                Int?      @map("__v")
  author           String?
  bannerUrl        String?
  blogContent      String
  blogContentDelta String?
  datePosted       DateTime  @db.Date
  description      String
  imageheader      String?
  isBannerDark     Boolean?
  isFeatured       Boolean?
  isPublished      Boolean?
  link             String?
  tags             String[]
  title            String
  updatedAt        DateTime?
  deleted          Boolean?
  deletedAt        DateTime?
}

model snippet {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  title       String @unique
  description String
  type        String
  content     String
  slug        String

  ownerId    String   @db.ObjectId
  datePosted DateTime @db.Date
  owner      users    @relation(fields: [ownerId], references: [id])
}

model apiKeys {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  name        String // User-friendly name for the key (e.g., "CI/CD Pipeline", "Mobile App")
  description String? // Optional longer description of what this key is used for

  // The key itself - only the hash is stored, prefix is kept for display/identification
  keyHash   String @unique // SHA-256 hash of the full API key
  keyPrefix String // First 8 chars for identification (e.g., "nhb_abcd...")

  // Permissions / Scopes
  scopes String[] // What the key can access: ["assets:read", "assets:write", "assets:delete"]

  // Tracking
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  expiresAt  DateTime? // Optional expiration date
  usageCount Int       @default(0) // Total number of times this key has been used

  // Status
  isActive  Boolean   @default(true)
  revokedAt DateTime? // When the key was revoked (null if still active)

  // Relationship - API key belongs to a user
  userId String @db.ObjectId
  user   users  @relation(fields: [userId], references: [id])

  // Usage logs
  usageLogs apiKeyUsageLogs[]

  @@index([userId])
  @@index([isActive])
}

model apiKeyUsageLogs {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  apiKeyId String  @db.ObjectId
  apiKey   apiKeys @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  endpoint   String // The API endpoint that was called (e.g., "/api/v2/assets")
  method     String // HTTP method (GET, POST, DELETE, etc.)
  statusCode Int // Response status code
  ipAddress  String? // Client IP address
  userAgent  String? // Client user agent string
  timestamp  DateTime @default(now())

  @@index([apiKeyId])
  @@index([timestamp])
}

model sessions {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  /// Field referred in an index, but found no data to define the type.
  expires Json?

  @@index([expires], map: "expires_1")
}

model tags {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  v           Int?     @map("__v")
  count       Int
  name        String   @unique
  posts       String[]
  description String?  @db.String
  color       String? // Hex color code (e.g., "#FF5733")
  aliases     String[] // Alternative names that map to this tag
}

model userauths {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  v           Int?     @map("__v")
  accessToken String
  lastAccess  DateTime @db.Date
  userId      String
}

model users {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  v           Int?      @map("__v")
  dateCreated DateTime  @db.Date
  email       String
  lastAccess  DateTime  @db.Date
  password    String
  username    String
  role        String
  name        String    @default("")
  birthday    DateTime? @default(now()) @db.Date
  gender      Gender?   @default(male)
  phone       String?   @default("")
  avatarUrl   String?   @default("")
  bio         String?   @default("")

  snippets snippet[]
  assets   assets[]
  apiKeys  apiKeys[]
}

model config {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  key         String      @unique
  value       String
  description String
  type        ConfigType? @default(string)
}

enum ConfigType {
  string
  number
  boolean
  json
}

enum Gender {
  male
  female
}

model assets {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Basic file information
  filename String // Original filename
  title    String? // User-friendly title
  slug     String  @unique // URL-friendly identifier

  // File details
  path     String // Storage path
  url      String // Full URL to access the file
  mimeType String // e.g., "image/jpeg", "video/mp4"
  fileSize Int // Size in bytes
  type     AssetType

  // Image/Video specific metadata
  width    Int?
  height   Int?
  duration Int? // For videos/audio, in seconds

  // SEO and accessibility
  altText     String? // For images
  caption     String?
  description String? @db.String // Longer description

  // Storage information
  remoteLocation RemoteLocation
  bucketName     String? // S3 bucket, GCS bucket name
  storageKey     String? // Actual key/path in remote storage

  // Upload status tracking (for presigned URL uploads)
  uploadStatus  UploadStatus @default(Completed)
  statusMessage String? // Error message or status details

  // Organization
  folder String? // Virtual folder path like "/images/2024/01"
  tags   String[] // Array of tags for searching

  // Relationships
  uploaderId String @db.ObjectId
  uploader   users  @relation(fields: [uploaderId], references: [id])

  // Variants/Versions (for image thumbnails, etc.)
  variants AssetVariant[]

  // Usage tracking
  usageCount Int       @default(0) // How many times it's referenced
  lastUsedAt DateTime?

  // Metadata
  metadata Json? // Flexible field for EXIF, custom data, etc.

  // Timestamps
  uploadedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  Int      @default(-1) // Soft delete - Unix timestamp (-1 = not deleted)

  // Indexes for performance
  @@index([uploaderId])
  @@index([type])
  @@index([mimeType])
  @@index([uploadedAt])
  @@index([folder])
  @@index([deletedAt])
}

model AssetVariant {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  assetId String @db.ObjectId
  asset   assets @relation(fields: [assetId], references: [id], onDelete: Cascade)

  name     String // e.g., "thumbnail", "medium", "large", "original"
  path     String
  url      String
  width    Int?
  height   Int?
  fileSize Int

  createdAt DateTime @default(now())

  @@unique([assetId, name])
  @@index([assetId])
}

enum AssetType {
  Image
  Video
  Audio
  Document
  Archive
  Other
}

enum RemoteLocation {
  Local // Self-hosted
  S3
  Other
}

// Status for tracking asset upload progress (for presigned URL uploads)
enum UploadStatus {
  Pending // Presigned URL generated, waiting for upload
  Uploaded // File uploaded to storage, waiting for processing
  Processing // Asset is being processed (metadata extraction, variants)
  Completed // Fully processed and ready to use
  Failed // Upload or processing failed
}

// Internal Analytics - Page View Tracking
model PageView {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  path       String // The page path (e.g., "/post/123")
  referrer   String? // Where the user came from
  userAgent  String? // Raw user agent string
  deviceType String? // Parsed: "desktop", "mobile", "tablet", "bot"
  browser    String? // Parsed browser name
  os         String? // Parsed operating system
  visitorId  String? // Anonymous visitor identifier (cookie-based)
  timestamp  DateTime @default(now()) @db.Date

  @@index([path])
  @@index([timestamp])
  @@index([visitorId])
  @@index([deviceType])
}
